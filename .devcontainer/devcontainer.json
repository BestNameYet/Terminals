{
  "name": "MCP Remote Server Space",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    }
  },
  "forwardPorts": [
    3000
  ],
  "portsAttributes": {
    "3000": {
      "label": "Issue #3 MCP Terminal",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "cd workspaces/codespace-terminal-mcp && npm install",
  "waitFor": "postCreateCommand",
  "postStartCommand": "bash workspaces/codespace-terminal-mcp/start-mcp.sh",
  "postAttachCommand": "gh codespace ports visibility 3000:public -c \"$CODESPACE_NAME\"",
  "containerEnv": {
    "MCP_ALLOWED_GITHUB_LOGIN": "BestNameYet",
    "MCP_PUBLIC_ORIGIN": "https://shiny-robot-v64x5jj4v4q2x96-3000.app.github.dev",
    "MCP_GH_OAUTH_CLIENT_ID": "Ov23liR4iwt16z8xcgik"
  }
}
