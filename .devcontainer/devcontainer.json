{
  "name": "MCP Remote Server Space",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    }
  },
  "forwardPorts": [
    3000
  ],
  "portsAttributes": {
    "3000": {
      "label": "MCP SSE Server",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "npm install -g @modelcontextprotocol/server-everything",
  "waitFor": "postCreateCommand",
  "postStartCommand": "nohup bash -lc 'PORT=3000 npx @modelcontextprotocol/server-everything streamableHttp' > /tmp/mcp-everything.log 2>&1 < /dev/null &"
}
