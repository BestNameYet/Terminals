  ],
  "x-terminals-contract": {
    "version": "1.0.0",
    "intended_path": "workspaces/codespace-mcp-srs-design/local-terminals/templates/agent-command-return.schema.json",
    "source_template_catalog": "workspaces/codespace-mcp-srs-design/local-terminals/templates/agent-command-templates.json",
    "phase": "design_only",
    "capture_boundary": "all_commands_executed_inside_observational_wrapper",
    "deterministic_rules": [
      "Never infer scripts, workflow runs, jobs, steps, file changes, or causality from timestamps or human interpretation.",
      "Carry original GitHub run_id, run_attempt, job_id, step number, commit SHA, source event identity and process IDs when observed.",
      "Capture verbatim stream bytes as base64; report exact decoded byte count, SHA256 and completeness. Text log APIs are not equivalent to raw process bytes.",
      "Record workflow status and conclusion independently; conclusion is present only when observed from the workflow API.",
      "Use observed causal edges with concrete evidence; an issued dispatch is not proof that a workflow ran.",
      "A returned empty array is permitted only if the corresponding observation scope was conclusively empty; otherwise omit the array and mark coverage partial or unavailable.",
      "If any observed content is redacted or intentionally omitted, do not mark its capture complete.",
      "Workflow runs that continue after the root command must be collected separately until completed or the observation scope is explicitly closed as partial.",
      "Do not replace command outcome with workflow outcome, or a GitHub Actions job success with independently verified file effects.",
      "For all files, retain source path and revisions; only include content bytes when observed, captured, and permitted by security policy.",
      "For all process chains, exhaustive subprocess lists require tracing or controlled child execution; otherwise process coverage is partial.",
      "JSON Schema validates shape; a separate deterministic semantic validator must check counts, hashes, linkage, chronological consistency, and coverage truthfulness."
    ]
  }
}
