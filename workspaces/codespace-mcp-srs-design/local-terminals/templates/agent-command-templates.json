{
  "schema": "terminals.local-terminals.agent-command-templates.v1",
  "version": "1.0.0",
  "type": "declarative_agent_command_template_catalog",
  "status": "design_only_not_an_executable_interface",
  "repository": "BestNameYet/Terminals",
  "path": "workspaces/codespace-mcp-srs-design/local-terminals/templates/agent-command-templates.json",
  "authority": {
    "governing": [
      "AGENTS.md",
      "terminals_requirements.json",
      "workspaces/codespace-mcp-srs-design/AGENTS.md"
    ],
    "note": "These templates do not grant authorization, install a parser, or replace the live Issue #3 JSON command contract."
  },
  "template_language": {
    "standard": "programs-selection-specification-v0.2.0",
    "representation": "This file is JSON; each source value is a string containing deliberately uncompiled source-template syntax.",
    "placeholder": "Unquoted <name> denotes a typed input; values are inserted according to slots.",
    "variable": "Unquoted $name is a runtime reference only where the chosen interface supports it.",
    "compile": "Resolve typed slots, validate constraints and target interface, then serialize to JSON; never submit source templates with unresolved placeholders."
  },
  "selection": {
    "default": "common_command",
    "file_writes": "file_change",
    "specialized": {
      "workflows": "workflow",
      "scripts": "code_script",
      "json": "json_document",
      "markdown": "markdown"
    }
  },
  "envelope": {
    "command": "string",
    "args": "object",
    "file_changes": "object present only for file create/edit; contains change payload rather than being nested inside args"
  },
  "templates": {
    "common_command": {
      "purpose": "Shared template for commands needing only a command name and arguments.",
      "source": "{\"command\": <command>, \"args\": <args>}",
      "slots": {
        "command": {
          "type": "string",
          "required": true
        },
        "args": {
          "type": "object",
          "required": true,
          "default": {}
        }
      },
      "constraints": [
        "No file_changes key unless files are created or edited.",
        "Resolve the command against the actual target interface before execution."
      ]
    },
    "file_change": {
      "purpose": "Generic create/edit template with content changes outside args.",
      "source": "{\"command\": <command>, \"args\": <args>, \"file_changes\": {\"action\": <action>, \"path\": <path>, \"write_mode\": <write_mode>, \"expected_sha\": <expected_sha>, \"content\": <content>}}",
      "slots": {
        "command": {
          "type": "string",
          "required": true
        },
        "args": {
          "type": "object",
          "required": true,
          "default": {}
        },
        "action": {
          "type": "string",
          "required": true,
          "enum": [
            "create",
            "edit"
          ]
        },
        "write_mode": {
          "type": "string",
          "required": true,
          "enum": [
            "replace",
            "patch"
          ]
        },
        "expected_sha": {
          "type": [
            "string",
            "null"
          ],
          "required": true
        },
        "path": {
          "type": "string",
          "required": true
        },
        "content": {
          "type": "string",
          "required": true
        }
      },
      "constraints": [
        "file_changes is top-level and separate from args.",
        "On create expected_sha is null and target must not exist; on edit expected_sha must match the remote revision.",
        "Patch mode requires a documented patch contract; otherwise replace entire content."
      ]
    },
    "workflow": {
      "purpose": "Create/edit workflow YAML.",
      "inherits": "file_change",
      "source": "{\"command\": <command>, \"args\": <args>, \"file_changes\": {\"action\": <action>, \"path\": <workflow_path>, \"write_mode\": <write_mode>, \"expected_sha\": <expected_sha>, \"workflow_yaml\": <workflow_yaml>}}",
      "slots": {
        "command": {
          "type": "string",
          "required": true
        },
        "args": {
          "type": "object",
          "required": true,
          "default": {}
        },
        "action": {
          "type": "string",
          "required": true,
          "enum": [
            "create",
            "edit"
          ]
        },
        "write_mode": {
          "type": "string",
          "required": true,
          "enum": [
            "replace",
            "patch"
          ]
        },
        "expected_sha": {
          "type": [
            "string",
            "null"
          ],
          "required": true
        },
        "workflow_path": {
          "type": "string",
          "required": true,
          "pattern": "^\\.github/workflows/[^/]+\\.ya?ml$"
        },
        "workflow_yaml": {
          "type": "string",
          "required": true
        }
      },
      "constraints": [
        "Design template only; does not authorize workflow changes.",
        "Repository contract requires direct GitHub integration for workflow-file mutations and prohibits Issue #3 for them.",
        "Validate YAML, events and permissions and verify the committed file."
      ]
    },
    "code_script": {
      "purpose": "Create/edit scripts with explicit source-code field.",
      "inherits": "file_change",
      "source": "{\"command\": <command>, \"args\": <args>, \"file_changes\": {\"action\": <action>, \"path\": <script_path>, \"write_mode\": <write_mode>, \"expected_sha\": <expected_sha>, \"language\": <language>, \"source_code\": <source_code>}}",
      "slots": {
        "command": {
          "type": "string",
          "required": true
        },
        "args": {
          "type": "object",
          "required": true,
          "default": {}
        },
        "action": {
          "type": "string",
          "required": true,
          "enum": [
            "create",
            "edit"
          ]
        },
        "write_mode": {
          "type": "string",
          "required": true,
          "enum": [
            "replace",
            "patch"
          ]
        },
        "expected_sha": {
          "type": [
            "string",
            "null"
          ],
          "required": true
        },
        "script_path": {
          "type": "string",
          "required": true
        },
        "language": {
          "type": "string",
          "required": true
        },
        "source_code": {
          "type": "string",
          "required": true
        }
      },
      "constraints": [
        "Source code remains an uninterpreted UTF-8 string until authorized execution.",
        "Syntax checks and relevant tests occur after the authorized write."
      ]
    },
    "json_document": {
      "purpose": "Create/edit JSON with a native typed document object or array.",
      "inherits": "file_change",
      "source": "{\"command\": <command>, \"args\": <args>, \"file_changes\": {\"action\": <action>, \"path\": <json_path>, \"write_mode\": <write_mode>, \"expected_sha\": <expected_sha>, \"document\": <json_document>}}",
      "slots": {
        "command": {
          "type": "string",
          "required": true
        },
        "args": {
          "type": "object",
          "required": true,
          "default": {}
        },
        "action": {
          "type": "string",
          "required": true,
          "enum": [
            "create",
            "edit"
          ]
        },
        "write_mode": {
          "type": "string",
          "required": true,
          "enum": [
            "replace",
            "patch"
          ]
        },
        "expected_sha": {
          "type": [
            "string",
            "null"
          ],
          "required": true
        },
        "json_path": {
          "type": "string",
          "required": true,
          "pattern": "\\.json$"
        },
        "json_document": {
          "type": [
            "object",
            "array"
          ],
          "required": true
        }
      },
      "constraints": [
        "document is a JSON object or array, never JSON text hidden within args.",
        "Serialize only after typed substitution and validate the resulting document.",
        "Patch mode requires a documented patch mechanism."
      ]
    },
    "markdown": {
      "purpose": "Create/edit Markdown using a dedicated text field.",
      "inherits": "file_change",
      "source": "{\"command\": <command>, \"args\": <args>, \"file_changes\": {\"action\": <action>, \"path\": <markdown_path>, \"write_mode\": <write_mode>, \"expected_sha\": <expected_sha>, \"markdown_text\": <markdown_text>}}",
      "slots": {
        "command": {
          "type": "string",
          "required": true
        },
        "args": {
          "type": "object",
          "required": true,
          "default": {}
        },
        "action": {
          "type": "string",
          "required": true,
          "enum": [
            "create",
            "edit"
          ]
        },
        "write_mode": {
          "type": "string",
          "required": true,
          "enum": [
            "replace",
            "patch"
          ]
        },
        "expected_sha": {
          "type": [
            "string",
            "null"
          ],
          "required": true
        },
        "markdown_path": {
          "type": "string",
          "required": true,
          "pattern": "\\.md$"
        },
        "markdown_text": {
          "type": "string",
          "required": true
        }
      },
      "constraints": [
        "Preserve fenced code, whitespace, and Markdown source verbatim.",
        "Validate required links and references as applicable."
      ]
    }
  },
  "examples": {
    "common_command": {
      "command": "read_file",
      "args": {
        "path": "workspaces/codespace-mcp-srs-design/README.md"
      }
    },
    "json_document": {
      "command": "file.create",
      "args": {},
      "file_changes": {
        "action": "create",
        "path": "workspaces/codespace-mcp-srs-design/local-terminals/example.json",
        "write_mode": "replace",
        "expected_sha": null,
        "document": {
          "enabled": true
        }
      }
    }
  },
  "validation": {
    "required": [
      "All six template definitions and their typed slots exist",
      "Every placeholder is declared by its template's slots",
      "Non-minimal templates place file_changes at top level instead of args",
      "A resolved template is valid JSON and satisfies the selected runtime's actual contract",
      "Create/edit operations verify scope, expected SHA, mutation receipt, and independent readback"
    ],
    "runtime_note": "Logical command identifiers in examples are not claims of existing Issue #3 commands."
  }
}
