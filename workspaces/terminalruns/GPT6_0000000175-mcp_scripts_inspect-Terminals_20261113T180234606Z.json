{
  "inputThis": "$:set -euo pipefail; for f in workspaces/codespace-terminal-mcp/start-mcp.sh workspaces/codespace-terminal-mcp/supervise-mcp.sh .devcontainer/devcontainer.json workspaces/codespace-terminal-mcp/package.json; do echo \"== $f\"; nl -ba \"$f\"; done; for f in references/user-defined-scope-rule.json references/conversation-analytics-rule.json conversations/conversation-record.template.json; do echo \"== $f\"; if test -f \"$f\"; then cat \"$f\"; else echo MISSING; fi; done",
  "outputThat": [
    "== workspaces/codespace-terminal-mcp/start-mcp.sh",
    "     1\t#!/usr/bin/env bash",
    "     2\tset -euo pipefail",
    "     3\tcd -- \"$(dirname -- \"${BASH_SOURCE[0]}\")\"",
    "     4\t",
    "     5\texport PORT=\"${PORT:-3000}\"",
    "     6\texport MCP_AUTH_STATE_FILE=\"${MCP_AUTH_STATE_FILE:-/workspaces/.terminals-mcp/${CODESPACE_NAME:?Codespace name is required}/oauth.json}\"",
    "     7\tfor name in MCP_GH_OAUTH_CLIENT_ID MCP_GH_OAUTH_CLIENT_SECRET MCP_ALLOWED_GITHUB_LOGIN MCP_PUBLIC_ORIGIN; do",
    "     8\t  if [[ -z ${!name:-} ]]; then",
    "     9\t    printf 'Terminals MCP startup: %s is missing.\\n' \"$name\" >&2",
    "    10\t    exit 1",
    "    11\t  fi",
    "    12\tdone",
    "    13\t",
    "    14\tumask 077",
    "    15\tstate_dir=$(dirname -- \"$MCP_AUTH_STATE_FILE\")",
    "    16\tmkdir -p -- \"$state_dir\"",
    "    17\tlog=\"$state_dir/server.log\"",
    "    18\texec 9>\"$state_dir/start.lock\"",
    "    19\tflock -w 35 9",
    "    20\t",
    "    21\tready() {",
    "    22\t  curl -fsS --max-time 1 \"http://127.0.0.1:$PORT/.well-known/oauth-authorization-server\" |",
    "    23\t    node -e 'const data=JSON.parse(require(\"node:fs\").readFileSync(0,\"utf8\")); process.exitCode=Number(data.issuer!==process.env.MCP_PUBLIC_ORIGIN.replace(/\\/$/,\"\"));' 2>/dev/null",
    "    24\t}",
    "    25\t",
    "    26\tif ready 2>/dev/null; then",
    "    27\t  exit 0",
    "    28\tfi",
    "    29\t",
    "    30\tprintf 'Starting Terminals MCP on port %s.\\n' \"$PORT\" >>\"$log\"",
    "    31\tsetsid --fork flock -n \"$state_dir/supervisor.lock\" bash supervise-mcp.sh </dev/null >>\"$log\" 2>&1 9>&-",
    "    32\tfor ((attempt=0; attempt<30; attempt++)); do",
    "    33\t  if ready 2>/dev/null; then",
    "    34\t    printf 'Terminals MCP is ready on port %s.\\n' \"$PORT\"",
    "    35\t    exit 0",
    "    36\t  fi",
    "    37\t  sleep 1",
    "    38\tdone",
    "    39\tprintf 'Terminals MCP did not become ready. See %s.\\n' \"$log\" >&2",
    "    40\texit 1",
    "== workspaces/codespace-terminal-mcp/supervise-mcp.sh",
    "     1\t#!/usr/bin/env bash",
    "     2\tset -u",
    "     3\tcd -- \"$(dirname -- \"$0\")\"",
    "     4\tchild=",
    "     5\ttrap 'if [[ -n $child ]]; then kill \"$child\" 2>/dev/null; wait \"$child\" 2>/dev/null; fi; exit 0' TERM INT",
    "     6\tdelay=1",
    "     7\twhile true; do",
    "     8\t  started=$SECONDS",
    "     9\t  node http-server.mjs &",
    "    10\t  child=$!",
    "    11\t  wait \"$child\"",
    "    12\t  status=$?",
    "    13\t  child=",
    "    14\t  if (( SECONDS - started >= 60 )); then delay=1; fi",
    "    15\t  printf \"MCP exited (%s). Retrying in %ss.\\n\" \"$status\" \"$delay\"",
    "    16\t  sleep \"$delay\" &",
    "    17\t  child=$!",
    "    18\t  wait \"$child\"",
    "    19\t  child=",
    "    20\t  delay=$(( delay < 16 ? delay * 2 : 30 ))",
    "    21\tdone",
    "== .devcontainer/devcontainer.json",
    "     1\t{",
    "     2\t  \"name\": \"MCP Remote Server Space\",",
    "     3\t  \"features\": {",
    "     4\t    \"ghcr.io/devcontainers/features/node:1\": {",
    "     5\t      \"version\": \"lts\"",
    "     6\t    }",
    "     7\t  },",
    "     8\t  \"forwardPorts\": [",
    "     9\t    3000",
    "    10\t  ],",
    "    11\t  \"portsAttributes\": {",
    "    12\t    \"3000\": {",
    "    13\t      \"label\": \"Issue #3 MCP Terminal\",",
    "    14\t      \"onAutoForward\": \"notify\"",
    "    15\t    }",
    "    16\t  },",
    "    17\t  \"postCreateCommand\": \"cd workspaces/codespace-terminal-mcp && npm install\",",
    "    18\t  \"waitFor\": \"postCreateCommand\",",
    "    19\t  \"postStartCommand\": \"bash workspaces/codespace-terminal-mcp/start-mcp.sh && timeout 30s gh codespace ports visibility 3000:public -c \\\"$CODESPACE_NAME\\\"\",",
    "    20\t  \"containerEnv\": {",
    "    21\t    \"MCP_ALLOWED_GITHUB_LOGIN\": \"BestNameYet\",",
    "    22\t    \"MCP_PUBLIC_ORIGIN\": \"https://shiny-robot-v64x5jj4v4q2x96-3000.app.github.dev\",",
    "    23\t    \"MCP_GH_OAUTH_CLIENT_ID\": \"Ov23liR4iwt16z8xcgik\"",
    "    24\t  }",
    "    25\t}",
    "== workspaces/codespace-terminal-mcp/package.json",
    "     1\t{",
    "     2\t  \"name\": \"terminals-issue3-mcp\",",
    "     3\t  \"version\": \"0.1.0\",",
    "     4\t  \"private\": true,",
    "     5\t  \"type\": \"module\",",
    "     6\t  \"scripts\": {",
    "     7\t    \"start\": \"node server.mjs\",",
    "     8\t    \"test\": \"node --check server.mjs\"",
    "     9\t  },",
    "    10\t  \"dependencies\": {",
    "    11\t    \"@modelcontextprotocol/sdk\": \"^1.20.0\"",
    "    12\t  }",
    "    13\t}",
    "== references/user-defined-scope-rule.json",
    "{",
    "  \"title\": \"User-Defined Operational Scope\",",
    "  \"applicability\": \"Applies to all agent decisions and actions undertaken to fulfill user requests, including interpretation, data selection, operation and deliverable choices, blocker assessment, verification, and completion reporting, regardless of task domain.\",",
    "  \"model\": {",
    "    \"entities\": {",
    "      \"data\": \"The input entities or collections on which operations act.\",",
    "      \"actions\": \"Operations requested or performed by the agent.\",",
    "      \"decisions\": \"Semantic or procedural choices made during execution.\",",
    "      \"scope\": \"The items, operations, constraints, and outputs covered by the request.\",",
    "      \"requirements\": \"Conditions that must be satisfied for completion.\",",
    "      \"deliverables\": \"Requested resulting artifacts, states, or outputs.\",",
    "      \"blockers\": \"Conditions preventing a required operation.\",",
    "      \"evidence\": \"Observations supporting execution and outcome claims.\",",
    "      \"outcome\": \"The observed result of executing an action.\",",
    "      \"evaluation\": \"Classification of conformance to the requested contract.\"",
    "    },",
    "    \"semantic_judgment\": {",
    "      \"authorized\": [",
    "        \"Interpret user terminology in context.\",",
    "        \"Determine which data satisfy user-defined predicates.\",",
    "        \"Select methods for implementing requested operations.\",",
    "        \"Identify dependencies between requested actions.\",",
    "        \"Resolve implementation details without changing requirements.\",",
    "        \"Classify blockers using observable evidence.\",",
    "        \"Determine whether the resulting state satisfies the request.\"",
    "      ],",
    "      \"unauthorized\": [",
    "        \"Replace a user-defined predicate.\",",
    "        \"Reduce an exhaustive scope to a subset.\",",
    "        \"Omit required operations or attributes.\",",
    "        \"Substitute another deliverable or required result.\",",
    "        \"Add unrequested deliverables or side effects.\",",
    "        \"Replace a requirement with a perceived equivalent.\",",
    "        \"Treat convenience or anticipated cost as an external blocker.\",",
    "        \"Claim completion without satisfying required conditions.\"",
    "      ]",
    "    },",
    "    \"classifications\": {",
    "      \"PASS\": \"All requirements are satisfied.\",",
    "      \"JUSTIFIED_INCOMPLETE\": \"A verified legitimate blocker prevents full compliance, and the unmet requirements are disclosed.\",",
    "      \"FAIL\": \"The agent makes an unauthorized scope change, improperly handles a blocker, or misrepresents completion.\"",
    "    }",
    "  },",
    "  \"examples\": [",
    "    {",
    "      \"id\": \"E01\",",
    "      \"name\": \"Complete coverage\",",
    "      \"request\": {",
    "        \"data\": \"Collection S\",",
    "        \"scope\": {",
    "          \"selection\": \"All elements satisfying predicate P\",",
    "          \"quantifier\": \"ALL\"",
    "        },",
    "        \"actions\": [",
    "          \"SELECT elements satisfying P\",",
    "          \"EXTRACT attributes A, B, C\",",
    "          \"TRANSFORM selected data into representation R\",",
    "          \"PERSIST result as deliverable D\",",
    "          \"VERIFY coverage, attributes, and output\"",
    "        ]",
    "      },",
    "      \"semantic_decision\": {",
    "        \"question\": \"How should P and the required attributes be resolved against the available data?\",",
    "        \"action\": \"Identify semantically matching elements and attributes without changing P or the required fields.\",",
    "        \"authority\": \"PERMITTED\"",
    "      },",
    "      \"execution\": {",
    "        \"selected\": \"All elements satisfying P\",",
    "        \"attributes\": [",
    "          \"A\",",
    "          \"B\",",
    "          \"C\"",
    "        ],",
    "        \"deliverable\": \"D\",",
    "        \"verification\": \"All required conditions satisfied\"",
    "      },",
    "      \"evaluation\": {",
    "        \"classification\": \"PASS\",",
    "        \"reason\": \"Execution preserves the requested selection, operations, attributes, deliverable, and verification.\"",
    "      }",
    "    },",
    "    {",
    "      \"id\": \"E02\",",
    "      \"name\": \"Legitimate partial completion\",",
    "      \"request\": {",
    "        \"data\": \"Collection S containing 10 eligible elements\",",
    "        \"scope\": {",
    "          \"selection\": \"All 10 elements\",",
    "          \"quantifier\": \"ALL\"",
    "        },",
    "        \"actions\": [",
    "          \"READ each element\",",
    "          \"TRANSFORM each element\",",
    "          \"COMBINE results\",",
    "          \"REPORT completion state\"",
    "        ]",
    "      },",
    "      \"semantic_decision\": {",
    "        \"question\": \"Can successful independent operations proceed when one element is inaccessible?\",",
    "        \"action\": \"Continue all executable operations and preserve the inaccessible element as an unmet requirement.\",",
    "        \"authority\": \"PERMITTED\"",
    "      },",
    "      \"execution\": {",
    "        \"processed\": 9,",
    "        \"unprocessed\": 1,",
    "        \"blocker\": {",
    "          \"type\": \"ACCESS_DENIED\",",
    "          \"evidence\": \"Authorized read rejected by the source\",",
    "          \"legitimacy\": \"VERIFIED\"",
    "        },",
    "        \"reported_status\": \"INCOMPLETE\",",
    "        \"unmet_scope_disclosed\": true",
    "      },",
    "      \"evaluation\": {",
    "        \"classification\": \"JUSTIFIED_INCOMPLETE\",",
    "        \"reason\": \"A verified external blocker prevents full coverage; completed work and unmet scope are accurately distinguished.\"",
    "      }",
    "    },",
    "    {",
    "      \"id\": \"E03\",",
    "      \"name\": \"Illegitimate scope reduction\",",
    "      \"request\": {",
    "        \"data\": \"Collection S containing 100 eligible elements\",",
    "        \"scope\": {",
    "          \"selection\": \"All 100 elements\",",
    "          \"quantifier\": \"ALL\"",
    "        },",
    "        \"actions\": [",
    "          \"PROCESS every eligible element\"",
    "        ]",
    "      },",
    "      \"semantic_decision\": {",
    "        \"question\": \"Should execution stop when additional operations consume time or resources?\",",
    "        \"action\": \"Terminate after 20 elements to reduce execution cost.\",",
    "        \"authority\": \"NOT_PERMITTED\"",
    "      },",
    "      \"execution\": {",
    "        \"processed\": 20,",
    "        \"unprocessed\": 80,",
    "        \"claimed_blocker\": \"Efficiency and resource consumption\",",
    "        \"verified_external_blocker\": false",
    "      },",
    "      \"evaluation\": {",
    "        \"classification\": \"FAIL\",",
    "        \"violations\": [",
    "          \"UNAUTHORIZED_SCOPE_REDUCTION\",",
    "          \"ILLEGITIMATE_BLOCKER\"",
    "        ]",
    "      }",
    "    },",
    "    {",
    "      \"id\": \"E04\",",
    "      \"name\": \"Deliverable substitution\",",
    "      \"request\": {",
    "        \"data\": \"Collection S\",",
    "        \"actions\": [",
    "          \"PROCESS S\",",
    "          \"SERIALIZE results into format F\",",
    "          \"PRODUCE deliverable D\"",
    "        ],",
    "        \"required_deliverable\": \"D\"",
    "      },",
    "      \"semantic_decision\": {",
    "        \"question\": \"Can another representation convey equivalent information?\",",
    "        \"action\": \"Replace D with alternative deliverable E.\",",
    "        \"authority\": \"NOT_PERMITTED\"",
    "      },",
    "      \"execution\": {",
    "        \"performed\": [",
    "          \"PROCESS S\",",
    "          \"PRODUCE E\"",
    "        ],",
    "        \"produced\": [",
    "          \"E\"",
    "        ],",
    "        \"omitted\": [",
    "          \"SERIALIZE into F\",",
    "          \"PRODUCE D\"",
    "        ]",
    "      },",
    "      \"evaluation\": {",
    "        \"classification\": \"FAIL\",",
    "        \"violations\": [",
    "          \"DELIVERABLE_SUBSTITUTION\"",
    "        ]",
    "      }",
    "    },",
    "    {",
    "      \"id\": \"E05\",",
    "      \"name\": \"Unrequested deliverable addition\",",
    "      \"request\": {",
    "        \"data\": \"State S\",",
    "        \"actions\": [",
    "          \"APPLY transformation T\"",
    "        ],",
    "        \"required_deliverables\": [",
    "          \"Updated S\"",
    "        ]",
    "      },",
    "      \"semantic_decision\": {",
    "        \"question\": \"Would additional outputs or actions be useful?\",",
    "        \"action\": \"Produce artifact E and modify unrelated state U without authorization.\",",
    "        \"authority\": \"NOT_PERMITTED\"",
    "      },",
    "      \"execution\": {",
    "        \"performed\": [",
    "          \"APPLY transformation T\",",
    "          \"CREATE artifact E\",",
    "          \"MODIFY state U\"",
    "        ],",
    "        \"requested_result_satisfied\": true",
    "      },",
    "      \"evaluation\": {",
    "        \"classification\": \"FAIL\",",
    "        \"violations\": [",
    "          \"UNREQUESTED_DELIVERABLE\",",
    "          \"UNAUTHORIZED_SIDE_EFFECT\"",
    "        ]",
    "      }",
    "    },",
    "    {",
    "      \"id\": \"E06\",",
    "      \"name\": \"Requirement replacement\",",
    "      \"request\": {",
    "        \"data\": \"Collection S\",",
    "        \"scope\": {",
    "          \"selector\": \"P\",",
    "          \"quantifier\": \"ALL\"",
    "        },",
    "        \"actions\": [",
    "          \"SELECT using P\",",
    "          \"EXTRACT attribute A\"",
    "        ]",
    "      },",
    "      \"semantic_decision\": {",
    "        \"question\": \"Can easier-to-obtain data be used instead?\",",
    "        \"action\": \"Replace P with Q and attribute A with B.\",",
    "        \"authority\": \"NOT_PERMITTED\"",
    "      },",
    "      \"execution\": {",
    "        \"selector_used\": \"Q\",",
    "        \"attribute_extracted\": \"B\",",
    "        \"required_selector_used\": false,",
    "        \"required_attribute_extracted\": false",
    "      },",
    "      \"evaluation\": {",
    "        \"classification\": \"FAIL\",",
    "        \"violations\": [",
    "          \"SCOPE_CONSTRAINT_REPLACEMENT\",",
    "          \"REQUIREMENT_SUBSTITUTION\"",
    "        ]",
    "      }",
    "    },",
    "    {",
    "      \"id\": \"E07\",",
    "      \"name\": \"Silent requirement omission\",",
    "      \"request\": {",
    "        \"data\": \"Collection S\",",
    "        \"actions\": [",
    "          \"SELECT all elements satisfying P\",",
    "          \"EXTRACT A, B, C, D, E\"",
    "        ]",
    "      },",
    "      \"semantic_decision\": {",
    "        \"question\": \"Are all requested attributes necessary?\",",
    "        \"action\": \"Omit D and E based on perceived relevance.\",",
    "        \"authority\": \"NOT_PERMITTED\"",
    "      },",
    "      \"execution\": {",
    "        \"coverage\": \"ALL\",",
    "        \"extracted\": [",
    "          \"A\",",
    "          \"B\",",
    "          \"C\"",
    "        ],",
    "        \"omitted\": [",
    "          \"D\",",
    "          \"E\"",
    "        ],",
    "        \"omission_disclosed\": false",
    "      },",
    "      \"evaluation\": {",
    "        \"classification\": \"FAIL\",",
    "        \"violations\": [",
    "          \"REQUIREMENT_OMISSION\",",
    "          \"SILENT_NONCOMPLIANCE\"",
    "        ]",
    "      }",
    "    },",
    "    {",
    "      \"id\": \"E08\",",
    "      \"name\": \"Unauthorized relevance filtering\",",
    "      \"request\": {",
    "        \"data\": \"Collection S\",",
    "        \"scope\": {",
    "          \"selector\": \"P\",",
    "          \"quantifier\": \"ALL\"",
    "        },",
    "        \"actions\": [",
    "          \"PROCESS every element satisfying P\"",
    "        ]",
    "      },",
    "      \"semantic_decision\": {",
    "        \"question\": \"Which matching elements are sufficiently useful?\",",
    "        \"action\": \"Introduce additional relevance predicate Q.\",",
    "        \"authority\": \"NOT_PERMITTED\"",
    "      },",
    "      \"execution\": {",
    "        \"selector_used\": \"P AND Q\",",
    "        \"required_selector\": \"P\",",
    "        \"coverage\": \"SUBSET\"",
    "      },",
    "      \"evaluation\": {",
    "        \"classification\": \"FAIL\",",
    "        \"violations\": [",
    "          \"UNAUTHORIZED_FILTER\",",
    "          \"SCOPE_NARROWING\"",
    "        ]",
    "      }",
    "    },",
    "    {",
    "      \"id\": \"E09\",",
    "      \"name\": \"Sampling substituted for exhaustive operation\",",
    "      \"request\": {",
    "        \"data\": \"Collection S\",",
    "        \"scope\": {",
    "          \"quantifier\": \"ALL\"",
    "        },",
    "        \"actions\": [",
    "          \"APPLY operation T to every element\"",
    "        ]",
    "      },",
    "      \"semantic_decision\": {",
    "        \"question\": \"Can representative observations establish a general pattern?\",",
    "        \"action\": \"Apply T to sample S1 and extrapolate results to S.\",",
    "        \"authority\": \"NOT_PERMITTED\"",
    "      },",
    "      \"execution\": {",
    "        \"processed_set\": \"S1\",",
    "        \"relationship\": \"S1 is a proper subset of S\",",
    "        \"unprocessed_set\": \"S minus S1\",",
    "        \"deliverable_claim\": \"Results for all S\"",
    "      },",
    "      \"evaluation\": {",
    "        \"classification\": \"FAIL\",",
    "        \"violations\": [",
    "          \"SAMPLING_SUBSTITUTION\",",
    "          \"UNVERIFIED_EXTRAPOLATION\"",
    "        ]",
    "      }",
    "    },",
    "    {",
    "      \"id\": \"E10\",",
    "      \"name\": \"False completion assertion\",",
    "      \"request\": {",
    "        \"data\": \"State S\",",
    "        \"actions\": [",
    "          \"TRANSFORM S\",",
    "          \"PERSIST transformed state\",",
    "          \"VERIFY persisted state\"",
    "        ],",
    "        \"completion_condition\": \"All three actions succeed\"",
    "      },",
    "      \"semantic_decision\": {",
    "        \"question\": \"Does successful transformation establish task completion?\",",
    "        \"action\": \"Treat local transformation as proof of persistent and verified state.\",",
    "        \"authority\": \"NOT_PERMITTED\"",
    "      },",
    "      \"execution\": {",
    "        \"transformation\": \"SUCCESS\",",
    "        \"persistence\": \"NOT_PERFORMED\",",
    "        \"verification\": \"NOT_PERFORMED\",",
    "        \"reported_status\": \"COMPLETED\"",
    "      },",
    "      \"evaluation\": {",
    "        \"classification\": \"FAIL\",",
    "        \"violations\": [",
    "          \"UNPERFORMED_REQUIRED_ACTION\",",
    "          \"UNVERIFIED_COMPLETION_CLAIM\"",
    "        ]",
    "      }",
    "    }",
    "  ]",
    "}",
    "== references/conversation-analytics-rule.json",
    "{",
    "  \"title\": \"End-of-Turn Conversation Analytics Recording\",",
    "  \"applicability\": \"At the end of every completed assistant turn, create a complete conversation-analytics record from the active conversation-record template describing the corresponding user utterance, adjacent conversation context, and actual assistant response. Append that record exactly once to the persistent JSON array belonging to the current conversation. Do not change, remove, replace, or reorder existing records. Never claim that an append succeeded without verifying the persisted result.\",",
    "  \"trigger\": {",
    "    \"event\": \"end_of_completed_assistant_turn\",",
    "    \"response_capture\": \"Use the actual finalized assistant response at the end-of-turn boundary; construct the record only after the response is available. If the runtime cannot access it or cannot execute an end-of-turn callback, report the record as pending or failed rather than asserting completion.\"",
    "  },",
    "  \"template\": {",
    "    \"repository\": \"BestNameYet/Terminals\",",
    "    \"path\": \"conversations/conversation-record.template.json\",",
    "    \"template_id\": \"terminals.conversation-record\",",
    "    \"template_version\": \"1.0.0\",",
    "    \"revision_handling\": \"For each new record, use the current published template and its identified version. Preserve records generated under earlier versions unchanged; retain each record's template_id and template_version fields.\"",
    "  },",
    "  \"record\": {",
    "    \"structure\": \"All fields and nested fields of the referenced template, completed with the actual user utterance, preceding context, and assistant response.\",",
    "    \"identity_fields\": [",
    "      \"conversation_id\",",
    "      \"turn_id\"",
    "    ],",
    "    \"identity\": \"conversation_id is the stable identifier of the current conversation; turn_id uniquely identifies its completed assistant turn within that conversation. Record both along with every template field.\",",
    "    \"context\": \"Use only the preceding turns actually available, in chronological order, and record their actual count; never invent missing history.\",",
    "    \"validation\": \"Verify every required template field and nested type, that the user/response/context refer to the identified completed turn, and that conversation_id and turn_id are nonempty and match the target conversation.\"",
    "  },",
    "  \"destination\": {",
    "    \"repository\": \"BestNameYet/Terminals\",",
    "    \"directory\": \"conversations/\",",
    "    \"path\": \"conversations/analytics-<base64url_utf8_conversation_id>.json\",",
    "    \"filename_binding\": \"base64url of the UTF-8 bytes of the stable conversation_id, without padding; its exact reversible encoding identifies only that conversation and is safe as one path component.\",",
    "    \"format\": \"JSON array\",",
    "    \"initialize\": \"When the conversation array is absent, atomically create an empty JSON array before the first append; an existing valid array is reused. If an array appears concurrently, read and use it instead of replacing it.\"",
    "  },",
    "  \"append\": {",
    "    \"semantics\": \"Only append the new completed record; retain all previous record values and their order unchanged.\",",
    "    \"validation\": \"Parse the current persistent content as a JSON array and check that no element with the same conversation_id and turn_id already exists before appending.\",",
    "    \"atomicity\": \"Use a revision-conditional write (compare-and-swap against the current persistent file revision) of the updated valid JSON array; on a concurrent revision conflict, read the latest array and recheck uniqueness before retrying.\",",
