{
  "inputThis": "$:set -euo pipefail\necho '=== APP FILE SIZES ==='\nwc -lc workspaces/programs/scratchpad/{scratchpad.js,scratchpad-core.js,scratchpad-core.test.js,SRS.md,SRS.agent.json} workspaces/programs/runtime/program-mode.js workspaces/programs/sessions/state.json\necho '=== SCRATCHPAD ENTRYPOINT ==='; sed -n '1,280p' workspaces/programs/scratchpad/scratchpad.js\necho '=== SCRATCHPAD CORE ==='; sed -n '1,290p' workspaces/programs/scratchpad/scratchpad-core.js\necho '=== SESSION STATE ==='; cat workspaces/programs/sessions/state.json\necho '=== TEST RESULTS ==='; node --test workspaces/programs/scratchpad/scratchpad-core.test.js\necho '=== RUNNER NODE CHECK ==='; node --check workspaces/programs/runtime/program-mode.js; node --check workspaces/programs/scratchpad/scratchpad.js; node --check workspaces/programs/scratchpad/scratchpad-core.js\necho '=== PROGRAMS REGISTRY ==='; cat workspaces/programs/applications.json\necho '=== REQUIREMENTS VERSION ==='; node -e 'const r=require(\"./terminals_requirements.json\");console.log(JSON.stringify({version:r.version,requirements:r.requirements.length}))'",
