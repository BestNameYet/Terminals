  "inputThis": "$:set -euo pipefail\ncd \"$GITHUB_WORKSPACE\"\nSRC='terminal/tasks/fishFry/pizza_screen_minus01_centered_1448x1448_rotated_cw0p5_clean_upper_right_724x724.png'\nDST='terminal/tasks/fishFry/pizza_screen_minus01_centered_1448x1448_rotated_cw0p5_clean_upper_right_724x724_arrow_removed_opencv_base.png'\nEDGES='terminal/tasks/fishFry/pizza_screen_upper_right_724x724_arrow_removed_sobel_x.png'\ntest -f \"$SRC\" && test ! -e \"$DST\" && test ! -e \"$EDGES\"\ntest \"$(sha256sum \"$SRC\" | cut -d' ' -f1)\" = '4e6728722184fa091512afdf733ce2e72e822cc17369aeda49a936d923f22c74'\npython3 -m venv /tmp/fishfry-arrow-remove-opencv-corrected-venv\n/tmp/fishfry-arrow-remove-opencv-corrected-venv/bin/python -m pip -q install opencv-python-headless Pillow\n/tmp/fishfry-arrow-remove-opencv-corrected-venv/bin/python - <<'PY'\nfrom pathlib import Path\nimport cv2,numpy as np,hashlib,base64,io\nfrom PIL import Image\nsrc=Path('terminal/tasks/fishFry/pizza_screen_minus01_centered_1448x1448_rotated_cw0p5_clean_upper_right_724x724.png')\ndst=Path('terminal/tasks/fishFry/pizza_screen_minus01_centered_1448x1448_rotated_cw0p5_clean_upper_right_724x724_arrow_removed_opencv_base.png')\nedges=Path('terminal/tasks/fishFry/pizza_screen_upper_right_724x724_arrow_removed_sobel_x.png')\na=cv2.imread(str(src),cv2.IMREAD_COLOR)\nassert a is not None and a.shape==(724,724,3)\nroi=np.zeros((724,724),np.uint8)\nroi[430:,640:]=(np.max(a[430:,640:],axis=2)<100).astype(np.uint8)\nn,lab,stats,_=cv2.connectedComponentsWithStats(roi,8)\ncandidate=[(int(stats[i,cv2.CC_STAT_AREA]),i) for i in range(1,n) if stats[i,cv2.CC_STAT_AREA]>1000]\nassert len(candidate)==1,candidate\narea,index=candidate[0]\nx,y,w,h=map(int,stats[index,:4])\nassert (x,y,w,h)==(668,475,44,249),(x,y,w,h)\nmask=(lab==index).astype(np.uint8)*255\nmask=cv2.dilate(mask,cv2.getStructuringElement(cv2.MORPH_ELLIPSE,(5,5)),iterations=1)\nmodified=cv2.inpaint(a,mask,3,cv2.INPAINT_TELEA)\nassert np.array_equal(a[mask==0],modified[mask==0]),'Unexpected modifications outside arrow mask'\ndark_before=int(np.count_nonzero(np.max(a[430:,640:],axis=2)<100))\nafter_roi=(np.max(modified[430:,640:],axis=2)<100).astype(np.uint8)\ndark_after=int(np.count_nonzero(after_roi))\nn2,_,st2,_=cv2.connectedComponentsWithStats(after_roi,8)\nbiggest=max((int(st2[i,cv2.CC_STAT_AREA]) for i in range(1,n2)),default=0)\nprint('ARROW_DIAGNOSTICS','pre_black',dark_before,'post_black',dark_after,'post_largest_dark_component',biggest,flush=True)\nassert dark_before>=2400 and dark_after<=50 and biggest<30,(dark_before,dark_after,biggest)\nassert cv2.imwrite(str(dst),modified)\nloaded=cv2.imread(str(dst),cv2.IMREAD_COLOR)\nassert loaded is not None and loaded.shape==(724,724,3) and np.array_equal(loaded,modified)\ngray=cv2.cvtColor(loaded,cv2.COLOR_BGR2GRAY)\nblur=cv2.GaussianBlur(gray,(3,3),0)\ngx=cv2.Sobel(blur,cv2.CV_32F,1,0,ksize=3)\nsobel=cv2.convertScaleAbs(gx)\nassert cv2.imwrite(str(edges),sobel)\nassert np.array_equal(cv2.imread(str(edges),cv2.IMREAD_GRAYSCALE),sobel)\nsource_sha=hashlib.sha256(src.read_bytes()).hexdigest()\nassert source_sha=='4e6728722184fa091512afdf733ce2e72e822cc17369aeda49a936d923f22c74'\nprint('OPENCV',cv2.__version__,'ARROW_BOX',x,y,w,h,'ARROW_AREA',area,'PIXELS_CHANGED',np.count_nonzero(np.any(modified!=a,axis=2)),flush=True)\nprint('VERIFIED','exact source unchanged; edited image differs only within dilated arrow component; 724x724 PNG readback; arrow disconnected and absent',flush=True)\nprint('CLEAN_BASE',dst,'BYTES',dst.stat().st_size,'SHA256',hashlib.sha256(dst.read_bytes()).hexdigest(),flush=True)\nprint('SOBEL_X',edges,'BYTES',edges.stat().st_size,'SHA256',hashlib.sha256(edges.read_bytes()).hexdigest(),flush=True)\npreview=Image.fromarray(cv2.cvtColor(loaded,cv2.COLOR_BGR2RGB)).resize((440,440),Image.Resampling.LANCZOS)\nbuf=io.BytesIO();preview.save(buf,'JPEG',quality=48,optimize=True)\np64=base64.b64encode(buf.getvalue()).decode()\nassert len(p64)<85000,len(p64)\nprint('PREVIEW_BASE64:'+p64)\nPY\ngit add -- \"$DST\" \"$EDGES\"\ntest \"$(git diff --cached --name-only | wc -l)\" -eq 2\ngit -c user.name='github-actions[bot]' -c user.email='41898282+github-actions[bot]@users.noreply.github.com' commit -m 'Remove arrow using OpenCV and save clean mesh detection base'\ngh auth setup-git\nfor attempt in 1 2 3 4 5 6 7 8;do\n printf 'PUSH_ATTEMPT %s\\n' \"$attempt\"\n git fetch --quiet origin main\n git -c user.name='github-actions[bot]' -c user.email='41898282+github-actions[bot]@users.noreply.github.com' rebase origin/main\n if git push origin HEAD:main;then\n  printf 'COMMITTED ';git rev-parse HEAD\n  printf 'REMOTE_HEAD ';gh api repos/BestNameYet/Terminals/git/ref/heads/main --jq .object.sha\n  for f in \"$DST\" \"$EDGES\";do\n   L=$(git hash-object \"$f\")\n   R=$(gh api \"repos/BestNameYet/Terminals/contents/$f\" --jq .sha)\n   test \"$L\" = \"$R\"\n   printf 'VERIFIED_REMOTE %s %s\\n' \"$f\" \"$R\"\n  done\n  exit 0\n fi\ndone\necho 'PUBLICATION_FAILED' >&2\nexit 1",
