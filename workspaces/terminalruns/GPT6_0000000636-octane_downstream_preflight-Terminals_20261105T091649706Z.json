    "test(\"Octane malformed JSON and schema fail rather than fallback to legacy\",()=>{",
    " assert.throws(()=>parseHtmlResponse('<script id=\"__WEB_MOBILE_DATA__\">{x}</script>',validated),e=>e.code===\"INVALID_OCTANE_JSON\");",
