{
  "inputThis": "$:printf '%s\\n' '---CONFIG---'; cat .devcontainer/devcontainer.json; printf '%s\\n' '---MCP FILES---'; find .devcontainer -maxdepth 3 -type f -print; printf '%s\\n' '---MCP REFERENCES---'; rg -n 'mcpServers|mcp-server|modelcontextprotocol|MCP' .devcontainer workspaces --glob '*.json' --glob '*.js' --glob '*.mjs' | head -70",
  "outputThat": [
    "---CONFIG---",
    "{",
    "  \"name\": \"MCP Remote Server Space\",",
    "  \"features\": {",
    "    \"ghcr.io/devcontainers/features/node:1\": {",
    "      \"version\": \"lts\"",
    "    }",
    "  },",
    "  \"forwardPorts\": [",
    "    3000",
    "  ],",
    "  \"portsAttributes\": {",
