    "      \"source\": \"(resolve, reject) => {\\n      const child = spawn(cmd, argv, { ...options, stdio:['ignore','pipe','pipe'] });\\n      let timer;\\n      let bytes = 0, exceeded = false;\\n      function forward(stream, destination) {\\n        stream.on('data', chunk => {\\n          bytes += chunk.length;\\n          if (byteLimit !== undefined && bytes > byteLimit) {\\n            exceeded = true;\\n            child.kill('SIGKILL');\\n            return;\\n          }\\n          destination.write(chunk);\\n        });\\n      }\\n      forward(child.stdout, process.stdout);\\n      forward(child.stderr, process.stderr);\\n      if(timeoutMs !== undefined) timer=setTimeout(() => child.kill('SIGKILL'), timeoutMs);\\n      child.once('error',reject);\\n      child.once('close',(code,signal)=>{clearTimeout(timer);resolve({code,signal,exceeded});});\\n    }\"",
